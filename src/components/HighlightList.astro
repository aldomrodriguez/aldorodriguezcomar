---
import { highlights } from "../data/profile";
import Icon from "./Icon.astro";
import Tooltip from "./Tooltip.astro";
import IconMerge from "@tabler/icons/outline/git-merge.svg?raw";
import IconArrow from "@tabler/icons/outline/arrow-up-right.svg?raw";
---

<!-- Al pasar por un ítem, el resto se atenúa. -->
<div class="rounded-lg bg-neutral-100 p-3 sm:p-6 dark:bg-zinc-900">
  <ul class="group space-y-4">
    {
      highlights.map((item, index) => (
        <li class="group/item transition-opacity duration-300 group-has-hover:opacity-40 group-has-hover:hover:opacity-100">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="mb-2 flex flex-wrap items-center gap-2 sm:gap-3">
                <Icon svg={IconMerge} class="size-4 shrink-0 text-purple-500 dark:text-purple-400" />
                <h3 class="text-sm leading-6 font-medium text-black/80 sm:text-[15px] sm:leading-7 dark:text-white/80">{item.title}</h3>
                <span class="shrink-0 text-[10px] text-neutral-500 sm:text-xs dark:text-neutral-400">{item.year}</span>
              </div>
              <p class="text-xs leading-relaxed text-neutral-600 dark:text-neutral-400">{item.description}</p>
            </div>
            <Tooltip label="Ver proyecto">
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ver: ${item.title}`}
                class="grid shrink-0 place-items-center rounded-lg border-2 border-neutral-500 bg-neutral-200 p-2 transition hover:scale-105 dark:bg-neutral-800"
              >
                <Icon svg={IconArrow} class="size-4 text-neutral-600 dark:text-neutral-400" />
              </a>
            </Tooltip>
          </div>
          {index < highlights.length - 1 && <div class="mt-4 border-b border-neutral-300 dark:border-[#2E2E2E]" />}
        </li>
      ))
    }
  </ul>
</div>

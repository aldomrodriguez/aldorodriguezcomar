---
import { stack, type TechIcon } from "../data/profile";
import Icon from "./Icon.astro";
import IconHtml from "@tabler/icons/outline/brand-html5.svg?raw";
import IconCss from "@tabler/icons/outline/brand-css3.svg?raw";
import IconJs from "@tabler/icons/outline/brand-javascript.svg?raw";
import IconTs from "@tabler/icons/outline/brand-typescript.svg?raw";
import IconAstro from "@tabler/icons/outline/brand-astro.svg?raw";
import IconReact from "@tabler/icons/outline/brand-react.svg?raw";
import IconNext from "@tabler/icons/outline/brand-nextjs.svg?raw";
import IconNode from "@tabler/icons/outline/brand-nodejs.svg?raw";
import IconTailwind from "@tabler/icons/outline/brand-tailwind.svg?raw";
import IconPhp from "@tabler/icons/outline/brand-php.svg?raw";
import IconMysql from "@tabler/icons/outline/brand-mysql.svg?raw";
import IconDatabase from "@tabler/icons/outline/database.svg?raw";
import IconGit from "@tabler/icons/outline/brand-git.svg?raw";
import IconDocker from "@tabler/icons/outline/brand-docker.svg?raw";
import IconMongo from "@tabler/icons/outline/brand-mongodb.svg?raw";
import IconWordpress from "@tabler/icons/outline/brand-wordpress.svg?raw";

const icons: Record<TechIcon, string> = {
  html5: IconHtml,
  css3: IconCss,
  javascript: IconJs,
  typescript: IconTs,
  astro: IconAstro,
  react: IconReact,
  nextjs: IconNext,
  nodejs: IconNode,
  tailwind: IconTailwind,
  php: IconPhp,
  mysql: IconMysql,
  database: IconDatabase,
  git: IconGit,
  docker: IconDocker,
  mongodb: IconMongo,
  wordpress: IconWordpress,
};
---

<!-- Carrusel infinito solo con CSS: la lista se duplica y se desplaza un 50%.
     Sin gap en el contenedor: el espacio va dentro de cada ítem para que el loop no salte. -->
<div class="relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
  <ul class="sr-only">
    {stack.map((tech) => <li>{tech.name}</li>)}
  </ul>
  <div class="flex w-max animate-marquee py-2 hover:[animation-play-state:paused]" aria-hidden="true">
    {
      [...stack, ...stack].map((tech) => (
        <div class="group flex min-w-24 flex-col items-center justify-center p-2 sm:min-w-[106px] sm:p-3">
          <Icon
            svg={icons[tech.icon]}
            class="mb-1.5 size-8 stroke-[1.5] text-fg-subtle transition group-hover:scale-110 group-hover:text-fg sm:mb-2 sm:size-10"
          />
          <span class="text-center text-[10px] leading-tight font-medium text-neutral-700 transition-colors group-hover:text-neutral-900 sm:text-xs dark:text-neutral-300 dark:group-hover:text-white">
            {tech.name}
          </span>
        </div>
      ))
    }
  </div>
</div>

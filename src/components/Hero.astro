---
import { Image } from "astro:assets";
import { profile } from "../data/profile";
import fotoPerfil from "../assets/perfil.webp";
import Banner from "./Banner.astro";
import Icon from "./Icon.astro";
import Tactile from "./Tactile.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Tooltip from "./Tooltip.astro";
import IconGithub from "@tabler/icons/outline/brand-github.svg?raw";
import IconLinkedin from "@tabler/icons/outline/brand-linkedin.svg?raw";
import IconMail from "@tabler/icons/outline/mail.svg?raw";

const socials = [
  { label: "GitHub", href: profile.socials.github, icon: IconGithub },
  { label: "LinkedIn", href: profile.socials.linkedin, icon: IconLinkedin },
  { label: "Email", href: `mailto:${profile.socials.email}`, icon: IconMail },
];
---

<header class="mb-8">
  <div class="mb-2">
    <Banner />
  </div>

  <div class="-mt-10">
    <div class="mx-4 mb-4 sm:mx-8">
      <Image
        src={fotoPerfil}
        alt={profile.name}
        widths={[96, 112, 192, 224, 336]}
        sizes="(min-width: 640px) 112px, 96px"
        loading="eager"
        fetchpriority="high"
        class="relative z-10 size-24 rounded-full object-cover ring-4 ring-white sm:size-28 dark:ring-neutral-950"
      />
    </div>

    <div class="flex flex-col gap-3 px-4 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <div>
        <h1 class="font-display text-2xl font-medium tracking-[0.01em] sm:text-4xl">{profile.name}</h1>
        <p class="text-xs text-fg-subtle sm:text-sm">{profile.role} • {profile.location}</p>
      </div>

      <div class="flex flex-col items-start gap-2 sm:items-center">
        <nav aria-label="Redes" class="flex gap-1 sm:gap-2">
          {
            socials.map((social) => (
              <Tooltip label={social.label}>
                <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} class="rounded-2xl active:opacity-75">
                  <Tactile class="size-8">
                    <Icon svg={social.icon} />
                  </Tactile>
                </a>
              </Tooltip>
            ))
          }
          <ThemeToggle />
        </nav>
      </div>
    </div>
  </div>
</header>

<section aria-label="Sobre mí" class="px-4 pb-10 leading-relaxed sm:px-8" data-reveal>
  <p class="text-sm text-fg-muted sm:text-base">
    <strong class="font-medium text-neutral-900 dark:text-white">{profile.intro.highlight}</strong>
    {" "}{profile.intro.body}
  </p>
</section>

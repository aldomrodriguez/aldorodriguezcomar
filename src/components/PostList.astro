---
import { posts } from "../data/profile";
import Icon from "./Icon.astro";
import Tactile from "./Tactile.astro";
import IconArrow from "@tabler/icons/outline/arrow-up-right.svg?raw";
---

<ul class="group">
  {
    posts.map((post) => (
      <li>
        <a href={post.href} target="_blank" rel="noopener noreferrer" class="group/item block rounded-lg focus-visible:outline-2 focus-visible:outline-neutral-500 active:opacity-75">
          <article class="flex flex-col gap-4 border-b border-neutral-200 py-6 transition-opacity duration-300 group-has-hover:opacity-40 group-has-hover:group-hover/item:opacity-100 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-8 dark:border-neutral-800">
            <h3 class="min-w-0 flex-1 text-sm leading-6 font-medium text-black/80 transition-colors group-hover/item:text-black sm:text-[15px] sm:leading-7 dark:text-white/80 dark:group-hover/item:text-white">
              {post.title}
            </h3>
            <Tactile class="h-8 px-3 text-sm font-medium">
              Abrir <Icon svg={IconArrow} class="size-3.5" />
            </Tactile>
          </article>
        </a>
      </li>
    ))
  }
</ul>

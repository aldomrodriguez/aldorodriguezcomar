---
import { Image } from "astro:assets";
import { profile } from "../data/profile";
import fotoPerfil from "../assets/perfil.webp";
import Icon from "./Icon.astro";
import IconX from "@tabler/icons/outline/x.svg?raw";
---

<!-- Foto de perfil: al tocarla se abre más grande en un <dialog> nativo (Esc, clic afuera o la X la cierran). -->
<button
  type="button"
  data-photo-open
  aria-haspopup="dialog"
  aria-label={`Ver la foto de ${profile.name} más grande`}
  class="relative z-10 block cursor-zoom-in rounded-full transition-transform duration-200 ease-out hover:scale-[1.03] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-500 motion-reduce:transition-none motion-reduce:hover:scale-100"
>
  <Image
    src={fotoPerfil}
    alt={profile.name}
    widths={[96, 112, 192, 224, 336]}
    sizes="(min-width: 640px) 112px, 96px"
    loading="eager"
    fetchpriority="high"
    class="size-24 rounded-full object-cover ring-4 ring-white sm:size-28 dark:ring-neutral-950"
  />
</button>

<dialog
  data-photo-dialog
  aria-label={`Foto de ${profile.name}`}
  class="m-auto overflow-visible bg-transparent p-0 backdrop:bg-black/60 backdrop:backdrop-blur-sm open:animate-[foto-in_200ms_ease-out] motion-reduce:open:animate-none"
>
  <Image
    src={fotoPerfil}
    alt={profile.name}
    widths={[288, 512]}
    sizes="(min-width: 640px) 320px, 288px"
    class="size-72 rounded-full object-cover shadow-2xl ring-4 ring-white sm:size-80 dark:ring-neutral-950"
  />
  <form method="dialog" class="absolute -top-2 -right-2">
    <button
      type="submit"
      aria-label="Cerrar"
      class="grid size-9 place-items-center rounded-full bg-white text-neutral-900 shadow-lg ring-1 ring-black/10 transition-colors hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white dark:bg-neutral-900 dark:text-white dark:ring-white/15 dark:hover:bg-neutral-800"
    >
      <Icon svg={IconX} class="size-4" />
    </button>
  </form>
</dialog>

<style>
  @keyframes foto-in {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-photo-dialog]");
  const opener = document.querySelector<HTMLButtonElement>("[data-photo-open]");

  opener?.addEventListener("click", () => dialog?.showModal());
  // Un clic en el fondo (fuera de la foto) cae sobre el propio <dialog>: lo cierra.
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

---
import { experience } from "../data/profile";
import Icon from "./Icon.astro";
import IconChevron from "@tabler/icons/outline/chevron-down.svg?raw";
import IconArrow from "@tabler/icons/outline/arrow-up-right.svg?raw";
---

<!-- <details> nativo: se expande sin JavaScript y es accesible por teclado.
     Al pasar el mouse por una fila, las demás se atenúan (group-has-hover). -->
<ul class="group space-y-2 pb-4 text-black/70 dark:text-white/70">
  {
    experience.map((job) => (
      <li>
        <details class="group/item rounded-xl border border-transparent px-3 py-3 transition-[background-color,border-color,opacity] duration-250 ease-out group-has-hover:opacity-55 group-has-hover:hover:border-black/[0.08] group-has-hover:hover:bg-black/[0.025] group-has-hover:hover:opacity-100 sm:px-4 sm:py-4 dark:group-has-hover:hover:border-white/[0.08] dark:group-has-hover:hover:bg-white/[0.035]">
          <summary class="flex cursor-pointer list-none flex-col gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-500 sm:flex-row sm:items-center sm:justify-between [&::-webkit-details-marker]:hidden">
            <span class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full bg-white font-display text-lg font-bold text-black shadow-sm ring-1 shadow-black/[0.04] ring-black/10 sm:size-12 dark:bg-black dark:text-white dark:shadow-none dark:ring-white/15"
                aria-hidden="true"
              >
                {job.company[0]}
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-1.5 text-sm leading-6 font-semibold text-black/[0.86] sm:text-base dark:text-white/90">
                  {job.company}
                  {job.url && <Icon svg={IconArrow} class="size-3.5 opacity-50 transition-opacity group-hover/item:opacity-100" />}
                </span>
                <span class="block truncate text-xs font-medium text-black/45 sm:text-sm dark:text-white/45">{job.role}</span>
                <span class="mt-1 line-clamp-1 text-xs leading-5 text-black/50 group-open/item:line-clamp-none sm:text-sm dark:text-white/45">
                  {job.summary}
                </span>
              </span>
            </span>
            <span class="flex items-center gap-3 pl-[3.25rem] sm:pl-0">
              <span class="text-xs font-medium text-black/40 sm:text-sm dark:text-white/40">{job.period}</span>
              <span class="grid size-8 shrink-0 place-items-center rounded-full border border-black/[0.08] bg-black/[0.025] text-black/55 transition group-open/item:rotate-180 hover:border-black/15 hover:text-black dark:border-white/[0.08] dark:bg-white/[0.035] dark:text-white/55 dark:hover:border-white/15 dark:hover:text-white">
                <Icon svg={IconChevron} />
                <span class="sr-only">Ver detalles</span>
              </span>
            </span>
          </summary>
          <div class="mt-3 pl-[3.25rem] text-sm text-black/60 sm:pl-16 dark:text-white/55">
            <ul class="list-disc space-y-1 pl-4">
              {job.details.map((detail) => <li>{detail}</li>)}
            </ul>
            {job.url && (
              <a href={job.url} class="mt-3 inline-flex items-center gap-1 font-medium underline-offset-4 hover:underline" target="_blank" rel="noopener noreferrer">
                Visitar sitio <Icon svg={IconArrow} class="size-3.5" />
              </a>
            )}
          </div>
        </details>
      </li>
    ))
  }
</ul>

---
import { profile } from "../data/profile";
import Icon from "./Icon.astro";
import Tactile from "./Tactile.astro";
import IconLinkedin from "@tabler/icons/outline/brand-linkedin.svg?raw";
import IconMail from "@tabler/icons/outline/mail.svg?raw";

const links = [
  { label: "LinkedIn", href: profile.socials.linkedin, icon: IconLinkedin, external: true },
  { label: "Email", href: `mailto:${profile.socials.email}`, icon: IconMail, external: false },
];
---

<!-- Destino de los "#contacto" de Servicios. -->
<div id="contacto" class="mt-10 scroll-mt-8 text-center">
  <p class="mb-4 font-display text-base text-fg-muted italic sm:text-lg">{profile.cta.text}</p>
  <ul class="flex flex-wrap justify-center gap-3 sm:gap-4">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            class="inline-block rounded-2xl active:opacity-75"
          >
            <Tactile class="gap-2 px-4 py-2 text-sm sm:text-base">
              <Icon svg={link.icon} class="size-[18px] shrink-0" />
              {link.label}
            </Tactile>
          </a>
        </li>
      ))
    }
  </ul>
</div>

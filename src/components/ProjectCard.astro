---
import { Image } from "astro:assets";
import { projectUrl, type ProjectEntry } from "../lib/projects";
import Icon from "./Icon.astro";
import IconArrow from "@tabler/icons/outline/arrow-up-right.svg?raw";

type Props = { entry: ProjectEntry };

const { entry } = Astro.props;
const project = entry.data;
const visibleTags = project.tags.slice(0, 3);
const hiddenCount = project.tags.length - visibleTags.length;
const ease = "ease-[cubic-bezier(0.22,1,0.36,1)]";
---

<!-- Hover: se enciende el fondo de color, el título viaja al centro y la captura baja.
     La grilla que la contiene (clase "group") atenúa las demás tarjetas. -->
<a href={projectUrl(entry)} class="group/item block w-full rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-500">
  <div
    class="flex w-full flex-col gap-3 rounded-xl border border-black/10 bg-white/80 p-1 shadow-sm shadow-black/[0.03] transition-[border-color,box-shadow,opacity] duration-300 ease-out group-has-hover:opacity-55 group-has-hover:group-hover/item:border-black/20 group-has-hover:group-hover/item:opacity-100 group-has-hover:group-hover/item:shadow-lg group-has-hover:group-hover/item:shadow-black/5 dark:border-white/10 dark:bg-white/[0.045] dark:shadow-none dark:group-has-hover:group-hover/item:border-white/[0.18] dark:group-has-hover:group-hover/item:shadow-black/35"
  >
    <div class="relative aspect-4/3 w-full overflow-hidden rounded-lg border border-black/5 bg-black/[0.04] dark:border-white/5 dark:bg-white/[0.06]">
      <!-- Fondo de color que aparece al hover -->
      <div
        class="absolute inset-0 opacity-0 transition-opacity duration-500 ease-out group-hover/item:opacity-100"
        style={`background: radial-gradient(90% 70% at 50% 100%, hsl(${project.hue} 90% 55%), transparent 70%), radial-gradient(60% 50% at 0% 0%, hsl(${project.hue} 90% 70% / .6), transparent), hsl(${project.hue} 60% 85%)`}
        aria-hidden="true"
      >
      </div>
      <span
        class:list={[
          "absolute top-4 left-4 z-20 text-sm font-semibold whitespace-nowrap text-black transition-[left,transform,color] duration-500 group-hover/item:left-1/2 group-hover/item:-translate-x-1/2 dark:text-white dark:group-hover/item:text-black",
          ease,
        ]}
        aria-hidden="true"
      >
        {project.title}
      </span>
      <div class:list={["absolute inset-x-3 bottom-0 z-10 transition-transform duration-500 group-hover/item:translate-y-5 sm:inset-x-5", ease]}>
        {
          project.cover ? (
            <Image
              src={project.cover}
              alt={project.coverAlt ?? `Captura de ${project.title}`}
              widths={[400, 640, 800]}
              sizes="(min-width: 640px) 340px, 90vw"
              class="h-auto w-full rounded-t-md object-cover object-top shadow-xl"
            />
          ) : (
            <div class="flex aspect-[16/10] w-full flex-col overflow-hidden rounded-t-md border border-b-0 border-white/10 bg-neutral-950 shadow-xl" aria-hidden="true">
              <span class="flex items-center gap-1 border-b border-white/10 px-2 py-1.5">
                <span class="size-1.5 rounded-full bg-white/25" />
                <span class="size-1.5 rounded-full bg-white/25" />
                <span class="size-1.5 rounded-full bg-white/25" />
                <span class="ml-2 h-1.5 w-16 rounded-full bg-white/10" />
              </span>
              <span class="flex flex-1 flex-col items-center justify-center gap-2 px-4">
                <span class="text-center font-display text-sm font-bold text-white sm:text-base">{project.title}</span>
                <span class="h-1 w-24 rounded-full bg-white/15" />
                <span class="mt-1 rounded-sm px-2 py-0.5 text-[8px] font-semibold text-white" style={`background: hsl(${project.hue} 85% 50%)`}>
                  Ver más
                </span>
              </span>
              <span class="h-6" style={`background: radial-gradient(70% 100% at 50% 100%, hsl(${project.hue} 90% 50% / .6), transparent)`} />
            </div>
          )
        }
      </div>
    </div>

    <div class="w-full px-2 pb-4">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-[15px] leading-6 font-semibold text-fg">{project.title}</h3>
          <p class="mt-1 line-clamp-2 text-sm leading-5 text-fg-muted">{project.description}</p>
        </div>
        <span
          class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-black/10 bg-black/[0.03] text-fg-muted transition-colors duration-300 group-hover/item:border-black/20 group-hover/item:text-black dark:border-white/10 dark:bg-white/[0.04] dark:group-hover/item:border-white/20 dark:group-hover/item:text-white"
        >
          <Icon svg={IconArrow} />
        </span>
      </div>
      <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tecnologías">
        {
          [...visibleTags, ...(hiddenCount > 0 ? [`+${hiddenCount}`] : [])].map((tag) => (
            <li class="rounded-full bg-black/5 px-2.5 py-1 text-xs text-fg-muted dark:bg-white/10">{tag}</li>
          ))
        }
      </ul>
    </div>
  </div>
</a>

---
import Icon from "./Icon.astro";
import Tactile from "./Tactile.astro";
import Tooltip from "./Tooltip.astro";
import IconSun from "@tabler/icons/outline/sun.svg?raw";
import IconMoon from "@tabler/icons/outline/moon.svg?raw";
---

<Tooltip label="Cambiar tema">
  <button type="button" data-theme-toggle aria-label="Cambiar a tema claro" class="rounded-2xl active:opacity-75">
    <Tactile class="size-8">
      <span class="hidden dark:inline"><Icon svg={IconSun} /></span>
      <span class="dark:hidden"><Icon svg={IconMoon} /></span>
    </Tactile>
  </button>
</Tooltip>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  const syncLabel = () => {
    button?.setAttribute("aria-label", root.classList.contains("dark") ? "Cambiar a tema claro" : "Cambiar a tema oscuro");
  };

  syncLabel();
  button?.addEventListener("click", () => {
    const dark = root.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
    syncLabel();
  });
</script>

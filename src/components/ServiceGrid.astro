---
import { services, type Service } from "../data/profile";
import Icon from "./Icon.astro";
import IconLayout from "@tabler/icons/outline/layout.svg?raw";
import IconCart from "@tabler/icons/outline/shopping-cart.svg?raw";
import IconCode from "@tabler/icons/outline/code.svg?raw";
import IconChatbot from "@tabler/icons/outline/message-chatbot.svg?raw";
import IconBuilding from "@tabler/icons/outline/building.svg?raw";
import IconSearch from "@tabler/icons/outline/search.svg?raw";
import IconExternal from "@tabler/icons/outline/external-link.svg?raw";

const icons: Record<Service["icon"], string> = {
  layout: IconLayout,
  building: IconBuilding,
  code: IconCode,
  "shopping-cart": IconCart,
  "message-chatbot": IconChatbot,
  search: IconSearch,
};
---

<!-- Tarjetas de proyectos: se elevan con sombra y la flecha se desplaza. -->
<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5">
  {
    services.map((service) => (
      <li>
        <a
          href={service.href}
          class="group flex h-full items-center gap-4 rounded-xl border border-black/10 p-4 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md hover:shadow-black/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-500 dark:border-white/10 dark:hover:shadow-black/50"
        >
          <span class="grid size-12 shrink-0 place-items-center">
            <Icon svg={icons[service.icon]} class="size-9 stroke-[1.5] text-black dark:text-white" />
          </span>
          <span class="min-w-0 flex-1">
            <h3 class="text-[1.05rem] leading-tight font-semibold text-zinc-900 dark:text-zinc-50">{service.title}</h3>
            <p class="mt-1 text-sm text-fg-muted">{service.description}</p>
          </span>
          <Icon svg={IconExternal} class="size-4 shrink-0 text-fg-subtle transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
      </li>
    ))
  }
</ul>

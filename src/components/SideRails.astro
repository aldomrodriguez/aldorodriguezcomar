---
// Franjas rayadas decorativas a los costados de la columna.
const rail =
  "pointer-events-none absolute inset-y-0 hidden w-[60px] border-x border-black/[0.06] bg-[repeating-linear-gradient(135deg,currentColor_0_1px,transparent_1px_8px)] text-black/[0.06] [mask-image:linear-gradient(to_bottom,transparent,black_5%,black_95%,transparent)] sm:block dark:border-white/[0.06] dark:text-white/[0.06]";
---

<div aria-hidden="true" class:list={[rail, "left-0"]}></div>
<div aria-hidden="true" class:list={[rail, "right-0"]}></div>

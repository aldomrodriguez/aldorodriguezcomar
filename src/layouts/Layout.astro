---
import "../styles/global.css";
import SideRails from "../components/SideRails.astro";
import Oneko from "../components/Oneko.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import SeoHead, { type SeoImage } from "../components/SeoHead.astro";
// Tipografías procesadas por Astro: salen con hash en /_astro/ y se pueden cachear un año.
import satoshi from "../assets/fonts/satoshi-variable.woff2?url";
import cabinetBold from "../assets/fonts/cabinet-grotesk-700.woff2?url";

type Props = {
  title: string;
  description: string;
  image?: SeoImage | undefined;
  type?: "website" | "article";
  schema?: object | undefined;
  noindex?: boolean;
};

const props = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead {...props} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preload" href={satoshi} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cabinetBold} as="font" type="font/woff2" crossorigin />
    <!-- Fondo del tema antes de que llegue el CSS: evita cuadros en blanco al cargar. -->
    <style is:inline>
      html { background: #f5f5f5; }
      html.dark { background: #0a0a0a; color-scheme: dark; }
    </style>
    <script is:inline>
      // Antes de pintar: aplica el tema guardado (evita parpadeos).
      try {
        if (localStorage.getItem("theme") === "light") document.documentElement.classList.remove("dark");
      } catch {}
    </script>
  </head>
  <body
    class="min-h-dvh bg-neutral-100 font-sans text-neutral-900 antialiased transition-colors duration-300 dark:bg-neutral-950 dark:text-neutral-100"
  >
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-neutral-900 focus:px-4 focus:py-2 focus:text-white"
      >Saltar al contenido</a
    >
    <div class="relative mx-auto max-w-4xl">
      <SideRails />
      <main id="contenido" tabindex="-1" class="relative outline-none mx-auto max-w-3xl border-x border-black/15 bg-white dark:border-white/10 dark:bg-neutral-950">
        <slot />
      </main>
    </div>
    <ScrollToTop />
    <Oneko />
    <script is:inline>
      // Corre al final del <body>, antes del primer pintado: oculta solo lo que está fuera de
      // pantalla y lo muestra con fundido cuando entra. Lo visible al cargar no se toca.
      (() => {
        if (!("IntersectionObserver" in window)) return;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.remove("reveal-pending");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        for (const item of document.querySelectorAll("[data-reveal]")) {
          if (item.getBoundingClientRect().top < window.innerHeight) continue;
          item.classList.add("reveal-pending");
          observer.observe(item);
        }
      })();
    </script>
  </body>
</html>

---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ExperienceList from "../components/ExperienceList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import Contributions from "../components/Contributions.astro";
import StackMarquee from "../components/StackMarquee.astro";
import CallToAction from "../components/CallToAction.astro";
import { getImage } from "astro:assets";
import { profile, stack } from "../data/profile";
import { getProjects } from "../lib/projects";
import { homeSchema } from "../lib/seo";
import fotoPerfil from "../assets/perfil.webp";

const projects = await getProjects();

const site = Astro.site ?? new URL(profile.siteUrl);
const foto = await getImage({ src: fotoPerfil, width: 512 });
const schema = homeSchema({
  name: profile.name,
  jobTitle: profile.seo.jobTitle,
  description: profile.seo.description,
  siteUrl: site.href,
  imageUrl: new URL(foto.src, site).href,
  sameAs: [profile.socials.github, profile.socials.linkedin],
  locality: profile.seo.locality,
  region: profile.seo.region,
  skills: stack.map((tech) => tech.name),
});
---

<Layout title={profile.seo.title} description={profile.seo.description} schema={schema}>
  <Hero />

  <Section title="Experiencia" id="experiencia">
    <ExperienceList />
  </Section>

  <Section title="Proyectos" id="proyectos">
    <!-- "group": al pasar por una tarjeta, las demás se atenúan -->
    <div class="group grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-3">
      {projects.map((entry) => <ProjectCard entry={entry} />)}
    </div>
  </Section>

  <Section title="Servicios" id="servicios">
    <ServiceGrid />
    <CallToAction />
  </Section>

  <Section title="Contribuciones en GitHub" id="github" aside={`@${profile.githubUser}`} asideHref={`https://github.com/${profile.githubUser}`}>
    <Contributions user={profile.githubUser} />
  </Section>

  <Section title="Stack" id="stack">
    <p class="mb-4 text-sm leading-relaxed text-fg-muted sm:text-base">Tecnologías con las que construyo productos que resuelven problemas reales.</p>
    <StackMarquee />
  </Section>
  <!-- Aire al final de la página, debajo del último carrusel. -->
  <div class="h-16 sm:h-20" aria-hidden="true"></div>
</Layout>
